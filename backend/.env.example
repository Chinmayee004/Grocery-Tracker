# ── Server ────────────────────────────────────────────────────────────────
# Railway injects PORT automatically in production. Local default is 5000.
# PORT=5000

# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co
# Project Settings → API → service_role key (SECRET — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── CORS ──────────────────────────────────────────────────────────────────
# Frontend origin(s) allowed to call the REST API and open WebSockets.
# Comma-separated list is supported.
# Local dev: http://localhost:5173  ·  Production: your Netlify URL
CLIENT_URL=http://localhost:5173
