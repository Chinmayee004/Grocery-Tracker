{
  "name": "shared-grocery-list-monorepo",
  "version": "1.0.0",
  "description": "Production-ready Real-time Shared Grocery List with Supabase, Node/Express/Socket.io, and React/Vite",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "keywords": [
    "react",
    "vite",
    "socket.io",
    "express",
    "supabase",
    "postgresql",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1"
  }
}
