# Supabase Project Credentials (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend Service URL (Railway production URL, or local Express backend on port 5000)
VITE_API_URL=http://localhost:5000

# Backend Socket.io URL (defaults to VITE_API_URL if omitted)
# VITE_SOCKET_URL=http://localhost:5000
